\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Permutation sensitivity distributions over saved evaluation states. Deep Sets is exactly invariant by construction; PICR-MA\ substantially improves over IPPO on both MPE tasks, making the subsequent coordination mismatch harder to dismiss as a measurement artifact.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:perm}{{4}{6}{Permutation sensitivity distributions over saved evaluation states. Deep Sets is exactly invariant by construction; \method \ substantially improves over IPPO on both MPE tasks, making the subsequent coordination mismatch harder to dismiss as a measurement artifact}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces PICR-MA pilot ablations from the 20k, 3-seed sweep (mean $\pm $ standard error). The cross-play column reports same-family held-out partner cross-play. Bold entries mark the best cross-play and best JS within each environment. The table supports a narrow but useful claim: mild regularization is preferable, and teammate dropout is not helpful in this study.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:ablation}{{2}{6}{PICR-MA pilot ablations from the 20k, 3-seed sweep (mean $\pm $ standard error). The cross-play column reports same-family held-out partner cross-play. Bold entries mark the best cross-play and best JS within each environment. The table supports a narrow but useful claim: mild regularization is preferable, and teammate dropout is not helpful in this study}{table.2}{}}
