\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces MPE learning curves for the main 50k cohort. Solid lines show means across 5 seeds and shaded regions show standard error. The curves also make a substantive point for interpretation: \texttt  {simple\_spread\_v3} is still improving late in training, so a mild symmetry bias can interact with partially learned coordination conventions rather than only with converged policies.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:curves}{{2}{5}{MPE learning curves for the main 50k cohort. Solid lines show means across 5 seeds and shaded regions show standard error. The curves also make a substantive point for interpretation: \texttt {simple\_spread\_v3} is still improving late in training, so a mild symmetry bias can interact with partially learned coordination conventions rather than only with converged policies}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: same-family held-out partner ZSC summary for the main cohort. Right: matched IPPO$\rightarrow $PICR-MA\ seed-pair deltas; the diamond marks the mean paired delta and the error bars show a 95\% bootstrap interval over seeds. PICR-MA\ moves permutation sensitivity leftward on both tasks, but the associated cross-play shift is positive only inconsistently on \texttt  {simple\_adversary\_v3} and negative in every \texttt  {simple\_spread\_v3} pair.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:zsc-mismatch}{{3}{5}{Left: same-family held-out partner ZSC summary for the main cohort. Right: matched IPPO$\rightarrow $\method \ seed-pair deltas; the diamond marks the mean paired delta and the error bars show a 95\% bootstrap interval over seeds. \method \ moves permutation sensitivity leftward on both tasks, but the associated cross-play shift is positive only inconsistently on \texttt {simple\_adversary\_v3} and negative in every \texttt {simple\_spread\_v3} pair}{figure.3}{}}
